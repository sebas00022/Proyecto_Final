import discord
from discord.ext import commands
import asyncio
import json
import os
import unicodedata

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

ARCHIVO_PUNTAJES = "puntajes.json"

def cargar_puntajes():
    if os.path.exists(ARCHIVO_PUNTAJES):
        with open(ARCHIVO_PUNTAJES, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def guardar_puntajes(puntajes):
    with open(ARCHIVO_PUNTAJES, "w", encoding="utf-8") as f:
        json.dump(puntajes, f, indent=4)

def normalizar(texto):
    texto = texto.lower().strip()
    texto = unicodedata.normalize("NFD", texto)
    texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
    return texto

