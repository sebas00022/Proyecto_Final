@bot.event
async def on_ready():
    print(f"Bot conectado como {bot.user}")

@bot.command()
async def start(ctx):
    await ctx.send(
        f"**Cuestionario de Cambio Climático**\n"
        f"Hola {ctx.author.mention}, son 15 preguntas de verdadero o falso.\n"
        f"Responde con: verdadero, falso, v o f."
    )

    puntaje = 0
    falladas = []

    for i, pregunta in enumerate(preguntas, 1):
        await ctx.send(f"**Pregunta {i}/15**\n{pregunta['pregunta']}")

        def check(mensaje):
            return (
                mensaje.author == ctx.author
                and mensaje.channel == ctx.channel
                and normalizar(mensaje.content) in ["verdadero", "falso", "v", "f", "true", "false"]
            )

        try:
            respuesta_msg = await bot.wait_for("message", check=check, timeout=60.0)
            respuesta = normalizar(respuesta_msg.content)
            es_verdadero = respuesta in ["verdadero", "v", "true"]

            if es_verdadero == pregunta["correcta"]:
                puntaje += 1
                await ctx.send("Correcto.")
            else:
                falladas.append(pregunta)
                await ctx.send("Incorrecto.")

        except asyncio.TimeoutError:
            await ctx.send("Tiempo agotado. Cuestionario cancelado.")
            return

    puntajes = cargar_puntajes()
    user_id = str(ctx.author.id)
    puntaje_anterior = puntajes.get(user_id, 0)

    if puntaje > puntaje_anterior:
        puntajes[user_id] = puntaje
        guardar_puntajes(puntajes)
        await ctx.send(f"Resultado: {puntaje}/15\nNuevo record personal.")
    else:
        await ctx.send(f"Resultado: {puntaje}/15\nTu mejor puntaje es {puntaje_anterior}/15.")

    if falladas:
        await ctx.send("Consejos de las preguntas que fallaste:")
        for fallada in falladas:
            await ctx.send(f"- {fallada['pregunta']}\n  {fallada['consejo']}")
    else:
        await ctx.send("No fallaste ninguna pregunta.")

@bot.command()
async def puntaje(ctx):
    puntajes = cargar_puntajes()
    user_id = str(ctx.author.id)
    mejor = puntajes.get(user_id)

    if mejor is None:
        await ctx.send(f"{ctx.author.mention} aun no has hecho el cuestionario. Usa !start")
    else:
        await ctx.send(f"{ctx.author.mention} tu mejor puntaje es {mejor}/15")

